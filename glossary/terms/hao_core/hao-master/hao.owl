    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HAO_0000004">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">portion of organism substance</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HAO_0000006"/>
