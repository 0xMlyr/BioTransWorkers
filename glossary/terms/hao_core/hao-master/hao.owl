    <!-- http://purl.obolibrary.org/obo/HAO_0000001 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HAO_0000001">
        <rdfs:label rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ventral mesofurco-profurcal muscle</rdfs:label>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HAO_0001105"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/HAO#_attached_to"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/HAO_0000825"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/HAO#_attached_to"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/HAO_0000547"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <oboInOwl:id rdf:datatype="http://www.w3.org/2001/XMLSchema#string">HAO:0000001</oboInOwl:id>
        <obo:IAO_0000115 rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The profurcal muscle that arises from the mesofurcal bridge and inserts proximally of the profurca.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">fu2-fu1v</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mesothoracic interfurcal muscle</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym rdf:datatype="http://www.w3.org/2001/XMLSchema#string">ventral mesofurco-profurcal</oboInOwl:hasRelatedSynonym>
    </owl:Class>
    <owl:Axiom>
        <oboInOwl:hasDbXref rdf:datatype="http://www.w3.org/2001/XMLSchema#string">http://api.hymao.org/api/ref/68619</oboInOwl:hasDbXref>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mesothoracic interfurcal muscle</owl:annotatedTarget>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HAO_0000001"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#string">The profurcal muscle that arises from the mesofurcal bridge and inserts proximally of the profurca.</owl:annotatedTarget>
